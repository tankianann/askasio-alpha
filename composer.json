{
    "name": "local/rag-server",
    "description": "A standalone, single-user retrieval-augmented generation application.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "guzzlehttp/psr7": "^2.7",
        "league/commonmark": "^2.6",
        "monolog/monolog": "^3.0",
        "ramsey/uuid": "^4.7",
        "smalot/pdfparser": "^2.11",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {},
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "create-admin": "@php bin/create-admin.php",
        "embed-chunks": "@php bin/embed-chunks.php",
        "process-jobs": "@php bin/process-jobs.php --once",
        "prune-api-requests": "@php bin/prune-api-requests.php",
        "prune-chatbot-conversations": "@php bin/prune-chatbot-conversations.php",
        "recover-jobs": "@php bin/recover-jobs.php",
        "retrieve": "@php bin/retrieve.php",
        "test": "phpunit",
        "migrate": "@php bin/migrate.php",
        "worker": "@php bin/worker.php"
    }
}
